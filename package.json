{
    "name": "@biaspay/solid",
    "version": "0.1.1",
    "private": false,
    "description": "Solid SDK for Bias Elements",
    "keywords": [
        "solid"
    ],
    "homepage": "https://biaspay.com",
    "bugs": {
        "url": "https://github.com/BiasPay/elements-solid/issues"
    },
    "license": "MIT",
    "author": "Bias",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BiasPay/elements-solid.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "node": {
            "types": "./dist/index.d.ts",
            "default": "./dist/server.js"
        },
        "development": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "vite serve --config dev/vite.config.ts dev --port 3006",
        "build": "vite build && vite build --mode server && tsc -p tsconfig.build.json",
        "build:dev": "vite build --mode development && vite build --mode server && tsc -p tsconfig.build.json",
        "test": "bun run build && concurrently \"bun run test:client\" \"bun run test:ssr\" \"node test/package-ssr.mjs\"",
        "test:client": "vitest",
        "test:ssr": "vitest --mode ssr",
        "test:package-ssr": "bun run build && node test/package-ssr.mjs",
        "prepublishOnly": "bun run build",
        "update-deps": "bun update"
    },
    "dependencies": {
        "@biaspay/elements": "0.1.1",
        "@biaspay/sdk": "2.0.0"
    },
    "devDependencies": {
        "@tweakpane/core": "2.0.5",
        "@tweakpane/plugin-essentials": "0.2.1",
        "@types/node": "^26.6.4",
        "@vitest/browser": "^5.0.3",
        "@vitest/browser-playwright": "^5.0.3",
        "concurrently": "^10.0.5",
        "esbuild": "^0.28.2",
        "jsdom": "^30.1.2",
        "playwright": "^1.63.0",
        "solid-js": "^1.9.16",
        "solid-tweakpane": "^0.6.1",
        "tweakpane": "4.0.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^5.0.3"
    },
    "peerDependencies": {
        "solid-js": "^1.9.14"
    },
    "overrides": {
        "solid-js": "^1.9.16"
    },
    "engines": {
        "bun": ">=1.3.11",
        "node": ">=18"
    },
    "packageManager": "bun@1.4.2"
}
